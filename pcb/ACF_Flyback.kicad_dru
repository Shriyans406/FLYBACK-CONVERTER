(version 1)

(rule "hvmid_to_lv"
  (condition "(A.NetName == 'UV2' || A.NetName == 'FF2' || A.NetName == 'BL1' || A.NetName == 'LH2') && (B.NetName == 'PGND' || B.NetName == 'AGND' || B.NetName == 'VCC' || B.NetName == 'OUTA' || B.NetName == 'OUTB' || B.NetName == 'G1' || B.NetName == 'CS' || B.NetName == 'CSF' || B.NetName == 'REF5' || B.NetName == 'RT' || B.NetName == 'TIME' || B.NetName == 'SS' || B.NetName == 'COMP' || B.NetName == 'RAMP' || B.NetName == 'UVLO' || B.NetName == 'LEDA' || B.NetName == 'LB')")
  (constraint clearance (min 0.95mm)))

(rule "hvdc_to_lv_copper"
  (condition "(A.NetName == 'HV_IN' || A.NetName == 'HVDC' || A.NetName == 'UV1' || A.NetName == 'FF1' || A.NetName == 'LH1') && (B.NetName == 'PGND' || B.NetName == 'AGND' || B.NetName == 'VCC' || B.NetName == 'OUTA' || B.NetName == 'OUTB' || B.NetName == 'G1' || B.NetName == 'CS' || B.NetName == 'CSF' || B.NetName == 'REF5' || B.NetName == 'RT' || B.NetName == 'TIME' || B.NetName == 'SS' || B.NetName == 'COMP' || B.NetName == 'RAMP' || B.NetName == 'UVLO' || B.NetName == 'LEDA' || B.NetName == 'LB') && !(A.Type == 'Pad' && B.Type == 'Pad')")
  (constraint clearance (min 2.45mm)))

(rule "hvdc_to_lv_pads"
  (condition "(A.NetName == 'HV_IN' || A.NetName == 'HVDC' || A.NetName == 'UV1' || A.NetName == 'FF1' || A.NetName == 'LH1') && (B.NetName == 'PGND' || B.NetName == 'AGND' || B.NetName == 'VCC' || B.NetName == 'OUTA' || B.NetName == 'OUTB' || B.NetName == 'G1' || B.NetName == 'CS' || B.NetName == 'CSF' || B.NetName == 'REF5' || B.NetName == 'RT' || B.NetName == 'TIME' || B.NetName == 'SS' || B.NetName == 'COMP' || B.NetName == 'RAMP' || B.NetName == 'UVLO' || B.NetName == 'LEDA' || B.NetName == 'LB') && (A.Type == 'Pad' && B.Type == 'Pad')")
  (constraint clearance (min 1.5mm)))

(rule "swd_1kV_copper"
  (condition "(A.NetName == 'SW' || A.NetName == 'G2' || A.NetName == 'G2R' || A.NetName == 'VB') && (B.NetName == 'PGND' || B.NetName == 'AGND' || B.NetName == 'VCC' || B.NetName == 'OUTA' || B.NetName == 'OUTB' || B.NetName == 'G1' || B.NetName == 'CS' || B.NetName == 'CSF' || B.NetName == 'REF5' || B.NetName == 'RT' || B.NetName == 'TIME' || B.NetName == 'SS' || B.NetName == 'COMP' || B.NetName == 'RAMP' || B.NetName == 'UVLO' || B.NetName == 'LEDA' || B.NetName == 'LB' || B.NetName == 'HV_IN' || B.NetName == 'HVDC' || B.NetName == 'UV1' || B.NetName == 'FF1' || B.NetName == 'LH1' || B.NetName == 'UV2' || B.NetName == 'FF2' || B.NetName == 'BL1' || B.NetName == 'LH2' || B.NetName == 'VCL') && !(A.Type == 'Pad' && B.Type == 'Pad')")
  (constraint clearance (min 2.95mm)))

(rule "swd_1kV_pads"
  (condition "(A.NetName == 'SW' || A.NetName == 'G2' || A.NetName == 'G2R' || A.NetName == 'VB') && (B.NetName == 'PGND' || B.NetName == 'AGND' || B.NetName == 'VCC' || B.NetName == 'OUTA' || B.NetName == 'OUTB' || B.NetName == 'G1' || B.NetName == 'CS' || B.NetName == 'CSF' || B.NetName == 'REF5' || B.NetName == 'RT' || B.NetName == 'TIME' || B.NetName == 'SS' || B.NetName == 'COMP' || B.NetName == 'RAMP' || B.NetName == 'UVLO' || B.NetName == 'LEDA' || B.NetName == 'LB' || B.NetName == 'HV_IN' || B.NetName == 'HVDC' || B.NetName == 'UV1' || B.NetName == 'FF1' || B.NetName == 'LH1' || B.NetName == 'UV2' || B.NetName == 'FF2' || B.NetName == 'BL1' || B.NetName == 'LH2' || B.NetName == 'VCL') && (A.Type == 'Pad' && B.Type == 'Pad')")
  (constraint clearance (min 2.0mm)))

(rule "vcl_1kV_copper"
  (condition "(A.NetName == 'VCL') && (B.NetName == 'PGND' || B.NetName == 'AGND' || B.NetName == 'VCC' || B.NetName == 'OUTA' || B.NetName == 'OUTB' || B.NetName == 'G1' || B.NetName == 'CS' || B.NetName == 'CSF' || B.NetName == 'REF5' || B.NetName == 'RT' || B.NetName == 'TIME' || B.NetName == 'SS' || B.NetName == 'COMP' || B.NetName == 'RAMP' || B.NetName == 'UVLO' || B.NetName == 'LEDA' || B.NetName == 'LB' || B.NetName == 'HV_IN' || B.NetName == 'HVDC' || B.NetName == 'UV1' || B.NetName == 'FF1' || B.NetName == 'LH1' || B.NetName == 'UV2' || B.NetName == 'FF2' || B.NetName == 'BL1' || B.NetName == 'LH2') && !(A.Type == 'Pad' && B.Type == 'Pad')")
  (constraint clearance (min 2.95mm)))

(rule "vcl_1kV_pads"
  (condition "(A.NetName == 'VCL') && (B.NetName == 'PGND' || B.NetName == 'AGND' || B.NetName == 'VCC' || B.NetName == 'OUTA' || B.NetName == 'OUTB' || B.NetName == 'G1' || B.NetName == 'CS' || B.NetName == 'CSF' || B.NetName == 'REF5' || B.NetName == 'RT' || B.NetName == 'TIME' || B.NetName == 'SS' || B.NetName == 'COMP' || B.NetName == 'RAMP' || B.NetName == 'UVLO' || B.NetName == 'LEDA' || B.NetName == 'LB' || B.NetName == 'HV_IN' || B.NetName == 'HVDC' || B.NetName == 'UV1' || B.NetName == 'FF1' || B.NetName == 'LH1' || B.NetName == 'UV2' || B.NetName == 'FF2' || B.NetName == 'BL1' || B.NetName == 'LH2') && (A.Type == 'Pad' && B.Type == 'Pad')")
  (constraint clearance (min 2.0mm)))

(rule "primary_secondary_isolation"
  (condition "(A.NetName == 'SEC_A' || A.NetName == 'VOUT' || A.NetName == 'SGND' || A.NetName == 'FBM' || A.NetName == 'FB' || A.NetName == 'KA' || A.NetName == 'OPA' || A.NetName == 'CMP1' || A.NetName == 'LO1') && (B.NetName == 'PGND' || B.NetName == 'AGND' || B.NetName == 'VCC' || B.NetName == 'OUTA' || B.NetName == 'OUTB' || B.NetName == 'G1' || B.NetName == 'CS' || B.NetName == 'CSF' || B.NetName == 'REF5' || B.NetName == 'RT' || B.NetName == 'TIME' || B.NetName == 'SS' || B.NetName == 'COMP' || B.NetName == 'RAMP' || B.NetName == 'UVLO' || B.NetName == 'LEDA' || B.NetName == 'LB' || B.NetName == 'HV_IN' || B.NetName == 'HVDC' || B.NetName == 'UV1' || B.NetName == 'FF1' || B.NetName == 'LH1' || B.NetName == 'UV2' || B.NetName == 'FF2' || B.NetName == 'BL1' || B.NetName == 'LH2' || B.NetName == 'SW' || B.NetName == 'G2' || B.NetName == 'G2R' || B.NetName == 'VB' || B.NetName == 'VCL')")
  (constraint clearance (min 7.9mm)))
